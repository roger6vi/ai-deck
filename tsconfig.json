{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": false
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "rollup.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "com.gentleman.ai-deck.sdPlugin/bin"]
}
